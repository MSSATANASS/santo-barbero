{
  "name": "santo-barbero",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "homepage": "https://mssatanass.github.io/santo-barbero",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist",
    "admin": "vite --open \"/?admin=1\"",
    "publicar": "cd scripts/facebook && node ai-content-generator.js publish",
    "semana": "cd scripts/facebook && node scheduler.js weekly",
    "fotos": "cd scripts/facebook && node publish-gallery.js web",
    "stats": "cd scripts/facebook && node dashboard.js",
    "fb:setup": "cd scripts/facebook && npm install",
    "fb:test": "cd scripts/facebook && node test-connection.js",
    "fb:post": "cd scripts/facebook && node ai-content-generator.js",
    "fb:schedule": "cd scripts/facebook && node scheduler.js",
    "fb:gallery": "cd scripts/facebook && node publish-gallery.js",
    "mobile": "vite --host --open"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "framer-motion": "^12.23.24",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "overrides": {
    "node-domexception": "file:patches/node-domexception"
  }
}
