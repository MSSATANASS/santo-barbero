# Facebook Graph API Configuration
# Obtén estos valores en: https://developers.facebook.com/apps/

# 1. Page Access Token (Token de acceso de página)
# - Ve a Graph API Explorer: https://developers.facebook.com/tools/explorer/
# - Selecciona tu página
# - Genera un token con permisos: pages_manage_posts, pages_read_engagement
FACEBOOK_PAGE_ACCESS_TOKEN=your_page_access_token_here

# 2. Page ID (ID de tu página)
# - Encuentra en: Configuración de página > Acerca de > ID de página
FACEBOOK_PAGE_ID=your_page_id_here

# 3. App ID y App Secret (opcional, para tokens de larga duración)
FACEBOOK_APP_ID=your_app_id_here
FACEBOOK_APP_SECRET=your_app_secret_here

# 4. Gemini API Key (para generación de contenido con IA)
GEMINI_API_KEY=your_gemini_api_key_here
